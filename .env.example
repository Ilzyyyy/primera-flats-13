# Admin login for /admin (required in production)
ADMIN_PASSWORD=change-me
# Optional: extra secret used to sign the login cookie
ADMIN_SECRET=

# Supabase storage (required on Vercel / Netlify so admin saves don't trigger a redeploy)
# Project Settings > API: Project URL and the service_role key (server-side only, never expose it)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
