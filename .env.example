# Admin login for /admin (required in production)
ADMIN_PASSWORD=change-me
# Optional: extra secret used to sign the login cookie
ADMIN_SECRET=

# Lets the admin save by committing to GitHub (required on Vercel / Netlify)
# Fine-grained token with "Contents: Read and write" on this repo only
PF_GITHUB_TOKEN=
PF_GITHUB_REPO=Ilzyyyy/primera-flats-13
PF_GITHUB_BRANCH=main
